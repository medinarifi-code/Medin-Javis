# ─── KI-Gehirn (Claude) ───────────────────────────────────────────
# API-Key von https://console.anthropic.com
ANTHROPIC_API_KEY=
# Modell & Denktiefe. "low" antwortet am schnellsten (gut für Sprache).
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# ─── Premium-Stimme (ElevenLabs) ──────────────────────────────────
# Leer lassen = Browser-Stimme wird benutzt.
ELEVENLABS_API_KEY=
# Stimme aus deiner ElevenLabs Voice Library (Voice-ID kopieren)
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# ─── E-Mail (IMAP zum Lesen, SMTP zum Senden) ─────────────────────
# Beispiele: Gmail imap.gmail.com/smtp.gmail.com, GMX imap.gmx.net/mail.gmx.net,
#            Web.de imap.web.de/smtp.web.de, Outlook outlook.office365.com/smtp.office365.com
IMAP_HOST=
IMAP_PORT=993
SMTP_HOST=
SMTP_PORT=465
MAIL_USER=
# App-Passwort (NICHT dein normales Passwort, siehe README)
MAIL_PASS=
MAIL_FROM_NAME=

# ─── Persönliches ────────────────────────────────────────────────
USER_NAME=Sir
PORT=3000

# Nur für den Online-Betrieb (z. B. Render): HOST=0.0.0.0 und ein Passwort setzen.
# HOST=0.0.0.0
# APP_PASSWORD=
